local constellationGroup = Instance.new("Model", fxFolder)
constellationGroup.Name = "SkyConstellations"
local baseConstellationData = {}

local function buildConstellations()
	constellationGroup:ClearAllChildren()
	baseConstellationData = {}
	local patterns = {
		{Vector3.new(80, 130, 60), Vector3.new(115, 148, 85), Vector3.new(155, 142, 65), Vector3.new(185, 165, 95), Vector3.new(210, 150, 130)},
		{Vector3.new(-90, 140, -70), Vector3.new(-130, 160, -50), Vector3.new(-165, 145, -85), Vector3.new(-140, 120, -115)},
		{Vector3.new(-40, 155, 110), Vector3.new(0, 170, 135), Vector3.new(45, 150, 125), Vector3.new(25, 130, 95), Vector3.new(-40, 155, 110)},
		{Vector3.new(110, 135, -100), Vector3.new(145, 155, -130), Vector3.new(180, 140, -110)}
	}
	for _, pts in ipairs(patterns) do
		for i = 1, #pts do
			local star = Instance.new("Part", constellationGroup)
			star.Anchored = true
			star.CanCollide = false
			star.Shape = Enum.PartType.Ball
			star.Material = Enum.Material.Neon
			star.Color = State.ConstellationColor
			star.Size = Vector3.new(1.5, 1.5, 1.5)
			table.insert(baseConstellationData, {part = star, isLine = false, p1 = pts[i]})

			if i < #pts then
				local seg = Instance.new("Part", constellationGroup)
				seg.Anchored = true
				seg.CanCollide = false
				seg.Material = Enum.Material.Neon
				seg.Color = State.ConstellationColor
				seg.Size = Vector3.new(0.32, 0.32, (pts[i + 1] - pts[i]).Magnitude)
				table.insert(baseConstellationData, {part = seg, isLine = true, p1 = pts[i], p2 = pts[i + 1]})
			end
		end
	end
end
