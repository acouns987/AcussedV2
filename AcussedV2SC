local vpCharClone, vpHatPart, vpHatMesh, vpAuraPart, vpAuraMesh

local function rebuildViewportCharacter()
	vpWorld:ClearAllChildren()
	local char = player.Character
	if not char then return end

	char.Archivable = true
	local ok, clone = pcall(function() return char:Clone() end)
	if not ok or not clone then return end

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("LocalScript") or desc:IsA("Script") or desc:IsA("BodyMover") or desc:IsA("Trail") or desc:IsA("Highlight") then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.Anchored = true
		end
	end
	clone.Parent = vpWorld
	vpCharClone = clone

	vpHatPart = Instance.new("Part", vpWorld)
	vpHatPart.Anchored = true
	vpHatPart.CanCollide = false
	vpHatPart.Material = Enum.Material.Neon
	vpHatPart.Color = State.HatColor
	vpHatPart.Size = Vector3.new(1, 1, 1)
	vpHatMesh = Instance.new("SpecialMesh", vpHatPart)
	vpHatMesh.MeshType = Enum.MeshType.FileMesh
	vpHatMesh.MeshId = "rbxassetid://1033714"

	vpAuraPart = Instance.new("Part", vpWorld)
	vpAuraPart.Anchored = true
	vpAuraPart.CanCollide = false
	vpAuraPart.Material = Enum.Material.Neon
	vpAuraPart.Color = State.HatColor
	vpAuraPart.Size = Vector3.new(0.2, 0.2, 0.2)
	vpAuraMesh = Instance.new("SpecialMesh", vpAuraPart)
	vpAuraMesh.MeshType = Enum.MeshType.FileMesh
	vpAuraMesh.MeshId = "rbxassetid://3270017"
	vpAuraMesh.Scale = Vector3.new(3.2, 3.2, 0.9)
end

