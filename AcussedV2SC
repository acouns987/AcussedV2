local function applySkyboxPreset(mode)
	local cc = Lighting:FindFirstChild("AccusedWorldCC") or Instance.new("ColorCorrectionEffect", Lighting)
	cc.Name = "AccusedWorldCC"
	local atmo = Lighting:FindFirstChild("AccusedWorldAtmo") or Instance.new("Atmosphere", Lighting)
	atmo.Name = "AccusedWorldAtmo"
	cc.Enabled = true
	if mode == "Crimson" then
		Lighting.ClockTime = 0
		cc.TintColor = Color3.fromRGB(255, 130, 145)
		cc.Contrast = 0.35
		cc.Saturation = 0.4
		atmo.Density = 0.42
		atmo.Color = Color3.fromRGB(95, 10, 20)
	elseif mode == "Nebula" then
		Lighting.ClockTime = 21
		cc.TintColor = Color3.fromRGB(185, 165, 255)
		cc.Contrast = 0.25
		cc.Saturation = 0.35
		atmo.Density = 0.32
		atmo.Color = Color3.fromRGB(35, 20, 75)
	elseif mode == "Cyber" then
		Lighting.ClockTime = 18.5
		cc.TintColor = Color3.fromRGB(150, 235, 255)
		cc.Contrast = 0.3
		cc.Saturation = 0.5
		atmo.Density = 0.28
		atmo.Color = Color3.fromRGB(15, 55, 85)
	else
		cc.Enabled = false
		atmo.Density = 0.2
		Lighting.ClockTime = 14
	end
end

