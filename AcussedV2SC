RunService.RenderStepped:Connect(function(dt)
	local now = tick()

	-- 1. Modo Chroma RGB Global
	if State.ChromaRGB then
		State.Accent = Color3.fromHSV((now * 0.18 * State.ChromaSpeed) % 1, 0.75, 1)
		for _, item in ipairs(ThemeTargets.Accents) do
			item.inst[item.prop] = State.Accent
		end
	end

	-- 2. Watermark Modular (Activa/Desactiva Nombre, FPS, Ping, Hora por separado)
	if now - lastClockTick >= 0.4 then
		lastClockTick = now
		local parts = {"ACCUSED"}
		if State.WmShowName then table.insert(parts, player.Name) end
		if State.WmShowFPS then
			local fps = math.round(1 / math.max(dt, 0.001))
			table.insert(parts, fps .. " FPS")
		end
		if State.WmShowPing then
			local ping = 42
			pcall(function() ping = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
			table.insert(parts, ping .. "ms")
		end
		if State.WmShowTime then
			table.insert(parts, getNormalTime())
		end
		wmLabel.Text = table.concat(parts, "   |   ")
		local targetW = math.clamp(wmLabel.TextBounds.X + 34, 110, 460)
		watermark.Size = UDim2.new(0, targetW, 0, 28)
		mediaBarFill.Size = UDim2.new((now % 30) / 30, 0, 1, 0)
	end

	-- 3. Avatar 3D en el Preview
	if vpCharClone and vpCharClone:FindFirstChild("HumanoidRootPart") then
		local vpHrp = vpCharClone.HumanoidRootPart
		local vpHead = vpCharClone:FindFirstChild("Head") or vpHrp
		if State.PreviewRotate then
			previewAngle = previewAngle + dt * 0.75
		end
		local camPos = vpHrp.Position + Vector3.new(math.sin(previewAngle) * State.PreviewZoom, 0.5, math.cos(previewAngle) * State.PreviewZoom)
		vpCam.CFrame = CFrame.lookAt(camPos, vpHrp.Position + Vector3.new(0, 0.15, 0))

		if vpHatPart and vpHatMesh then
			vpHatPart.Transparency = State.ChinaHat and (State.HatTransparency / 100) or 1
			vpHatPart.Color = State.HatColor
			vpHatMesh.Scale = Vector3.new(State.HatRadius, State.HatHeight, State.HatRadius)
			vpHatPart.CFrame = CFrame.new(vpHead.Position + Vector3.new(0, State.HatOffset, 0))
		end
		if vpAuraPart and vpAuraMesh then
			vpAuraPart.Transparency = State.AuraSwirl and 0.25 or 1
			vpAuraPart.Color = State.HatColor
			vpAuraMesh.Scale = Vector3.new(State.AuraRadius * 0.85, State.AuraRadius * 0.85, 0.9)
			vpAuraPart.CFrame = CFrame.new(vpHrp.Position + Vector3.new(0, math.sin(now * State.AuraSpeed) * 1.1, 0)) * CFrame.Angles(math.rad(75), now * State.AuraSpeed, 0)
		end
	end

	-- 4. Constelaciones 3D Animadas (Rotación orbital y pulso)
	local skyRot = CFrame.Angles(0, now * State.ConstellationSpeed * 0.15, 0)
	local pulse = 0.15 + (math.sin(now * 2.5) + 1) * 0.1
	for _, item in ipairs(baseConstellationData) do
		if State.Constellations then
			item.part.Transparency = pulse
			item.part.Color = State.ConstellationColor
			if item.isLine then
				local r1 = skyRot * item.p1
				local r2 = skyRot * item.p2
				item.part.CFrame = CFrame.lookAt((r1 + r2) * 0.5, r2)
			else
				item.part.Position = skyRot * item.p1
			end
		else
			item.part.Transparency = 1
		end
	end

	-- 5. Oxígeno Flotante y Rayos del Cielo
	oxygenEmitter.Enabled = State.OxygenParticles
	if State.OxygenParticles then
		oxygenPart.Position = camera.CFrame.Position + Vector3.new(0, 10, 0)
		oxygenEmitter.Rate = State.OxygenAmount
		oxygenEmitter.Color = ColorSequence.new(State.OxygenColor)
	end

	if State.SkyLightning and (now - lastLightningTime > 1.6) then
		lastLightningTime = now
		spawnSkyLightning()
	end

	-- 6. Círculo FOV e Iluminación
	if State.ShowFOV then
		local mPos = UserInputService:GetMouseLocation()
		fovCircle.Position = UDim2.new(0, mPos.X, 0, mPos.Y)
		fovCircle.Size = UDim2.new(0, State.AimFOV * 2, 0, State.AimFOV * 2)
	end
	if State.AmbientEnabled then
		Lighting.Ambient = State.AmbientColor
		Lighting.OutdoorAmbient = State.AmbientColor
	end

	-- 7. Efectos 3D en el Personaje Local
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHead = myChar and myChar:FindFirstChild("Head")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

	if myHead and State.ChinaHat then
		hatPart.Transparency = State.HatTransparency / 100
		hatPart.Color = State.HatColor
		hatMesh.Scale = Vector3.new(State.HatRadius, State.HatHeight, State.HatRadius)
		hatHighlight.Enabled = State.HatOutline
		local bob = State.HatAnimated and (math.sin(now * 3.2) * 0.22) or 0
		hatPart.CFrame = CFrame.new(myHead.Position + Vector3.new(0, State.HatOffset + bob, 0)) * CFrame.Angles(0, now * 1.8, 0)
	else
		hatPart.Transparency = 1
		hatHighlight.Enabled = false
	end

	if myHrp and State.AuraSwirl then
		auraRing1.Transparency = 0.22
		auraRing1.Color = State.HatColor
		ringMesh1.Scale = Vector3.new(State.AuraRadius, State.AuraRadius, 1.1)
		auraRing1.CFrame = CFrame.new(myHrp.Position + Vector3.new(0, math.sin(now * State.AuraSpeed) * 1.8, 0)) * CFrame.Angles(math.rad(72), now * State.AuraSpeed, 0)

		auraRing2.Transparency = 0.35
		auraRing2.Color = State.TrailColor
		ringMesh2.Scale = Vector3.new(State.AuraRadius * 0.82, State.AuraRadius * 0.82, 0.95)
		auraRing2.CFrame = CFrame.new(myHrp.Position + Vector3.new(0, -math.sin(now * State.AuraSpeed) * 1.8, 0)) * CFrame.Angles(math.rad(-72), -now * State.AuraSpeed, 0)
	else
		auraRing1.Transparency = 1
		auraRing2.Transparency = 1
	end

	for idx, orb in ipairs(spiritOrbs) do
		if myHrp and State.FloatingOrbs then
			orb.Transparency = 0.1
			orb.Color = (idx % 2 == 0) and State.HatColor or State.TrailColor
			local angle = (now * 2.4) + (idx * math.pi * 0.5)
			local yOff = math.sin(now * 4 + idx) * 1.4
			orb.Position = myHrp.Position + Vector3.new(math.cos(angle) * 3.2, yOff, math.sin(angle) * 3.2)
		else
			orb.Transparency = 1
		end
	end

	if myHrp and State.Flashlight then
		spotLight.Enabled = true
		spotLight.Range = State.FlashlightRange
		spotLight.Color = State.HatColor
		flashPart.CFrame = CFrame.lookAt(myHrp.Position + Vector3.new(0, 1.5, 0), myHrp.Position + camera.CFrame.LookVector * 20)
	else
		spotLight.Enabled = false
	end

	if myHrp then
		local tr = myHrp:FindFirstChild("AccusedTrail")
		if State.TrailEnabled then
			if not tr then
				local a0 = Instance.new("Attachment", myHrp) a0.Name = "AccA0" a0.Position = Vector3.new(0, 0.8, 0)
				local a1 = Instance.new("Attachment", myHrp) a1.Name = "AccA1" a1.Position = Vector3.new(0, -1.2, 0)
				tr = Instance.new("Trail", myHrp)
				tr.Name = "AccusedTrail"
				tr.Attachment0 = a0
				tr.Attachment1 = a1
				tr.LightEmission = 1
				tr.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)})
			end
			tr.Enabled = true
			tr.Lifetime = State.TrailDuration
			tr.Color = ColorSequence.new(State.TrailColor, State.HatColor)
		elseif tr then
			tr.Enabled = false
		end
	end

	-- 8. Movimiento y Físicas
	if myHum then
		if State.Walkspeed then myHum.WalkSpeed = State.SpeedVal end
		if State.JumpPower then myHum.UseJumpPower = true myHum.JumpPower = State.JumpVal end
	end
	if myHrp and State.Spinbot then
		myHrp.CFrame *= CFrame.Angles(0, math.rad(State.SpinSpeed), 0)
	end

	if State.Fly and myHrp and myHum then
		myHum.PlatformStand = true
		if not flyBV then
			flyBV = Instance.new("BodyVelocity", myHrp)
			flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			flyBG = Instance.new("BodyGyro", myHrp)
			flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
			flyBG.P = 9000
		end
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
		if dir.Magnitude > 0 then dir = dir.Unit * State.FlySpeed end
		flyVel = flyVel:Lerp(dir, 0.2)
		flyBV.Velocity = flyVel
		flyBG.CFrame = camera.CFrame
	else
		if flyBV then flyBV:Destroy() flyBV = nil end
		if flyBG then flyBG:Destroy() flyBG = nil end
		if myHum and myHum.PlatformStand then myHum.PlatformStand = false end
	end

	-- 9. ESP 2D Corner Box + Combate
	local targets = getTargetModels()
	local activeMap = {}
	local closestHead, shortestDist = nil, State.AimFOV
	local mPos = UserInputService:GetMouseLocation()

	for _, model in ipairs(targets) do
		local hrp = model:FindFirstChild("HumanoidRootPart")
		local head = model:FindFirstChild("Head") or hrp
		local hum = model:FindFirstChildOfClass("Humanoid")

		if hrp and hum and hum.Health > 0 then
			activeMap[model] = true
			local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)

			if onScreen and head then
				local hPos = camera:WorldToViewportPoint(head.Position)
				local d = (mPos - Vector2.new(hPos.X, hPos.Y)).Magnitude
				if d < shortestDist then
					shortestDist = d
					closestHead = head
				end
			end

			local boxUI = espBoxes[model] or create2DCornerBox(model)
			if State.EspEnabled and onScreen then
				local dist = math.max(screenPos.Z, 1)
				local boxH = math.clamp(2200 / dist, 28, 320)
				local boxW = boxH * 0.65
				boxUI.holder.Visible = true
				boxUI.holder.Size = UDim2.new(0, boxW, 0, boxH)
				boxUI.holder.Position = UDim2.new(0, screenPos.X - boxW * 0.5, 0, screenPos.Y - boxH * 0.5)
				boxUI.name.Visible = State.EspNames
				boxUI.hp.Visible = State.EspHealth
				local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				boxUI.hp.Size = UDim2.new(0, 2, hpRatio, 0)
				boxUI.hp.Position = UDim2.new(0, -5, 1 - hpRatio, 0)
				for _, c in ipairs(boxUI.corners) do
					c.Visible = State.EspCorners
					c.BackgroundColor3 = State.EspColor
				end
			else
				boxUI.holder.Visible = false
			end

			local hl = model:FindFirstChild("AccusedChams")
			if State.EspChams then
				if not hl then
					hl = Instance.new("Highlight", model)
					hl.Name = "AccusedChams"
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				end
				hl.FillColor = State.Accent
				hl.FillTransparency = 0.45
			elseif hl then
				hl:Destroy()
			end
		end
	end

	for model, boxUI in pairs(espBoxes) do
		if not activeMap[model] then
			boxUI.holder.Visible = false
		end
	end

	if State.AutoFarm and myHrp and #targets > 0 then
		local tModel = targets[1]
		local tHrp = tModel:FindFirstChild("HumanoidRootPart")
		if tHrp then
			myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, State.FarmDist)
			myHrp.AssemblyLinearVelocity = Vector3.zero
			local tool = myChar:FindFirstChildOfClass("Tool")
			if tool then tool:Activate() end
		end
	elseif State.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and closestHead then
		camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, closestHead.Position), State.AimSmooth / 100)
		if State.TriggerBot and myChar then
			local tool = myChar:FindFirstChildOfClass("Tool")
			if tool then tool:Activate() end
		end
	end
end)

-- =====================================================================================
-- 11. ANIMACIÓN DE APERTURA Y LANZAMIENTO CON INTRO MOTION GRAPHICS
-- =====================================================================================
local function toggleMenu()
	State.MenuOpen = not State.MenuOpen
	playClick()
	if State.MenuOpen then
		mainContainer.Visible = true
		mainUIScale.Scale = (State.UIScale / 100) * 0.92
		TweenService:Create(mainUIScale, TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = State.UIScale / 100
		}):Play()
	else
		local tw = TweenService:Create(mainUIScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Scale = (State.UIScale / 100) * 0.92
		})
		tw:Play()
		tw.Completed:Connect(function()
			if not State.MenuOpen then mainContainer.Visible = false end
		end)
	end
end

closeBtn.MouseButton1Click:Connect(toggleMenu)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.LeftControl then
		toggleMenu()
	elseif input.KeyCode == Enum.KeyCode.E then
		State.Fly = not State.Fly
		setFlyCheck(State.Fly)
	elseif input.KeyCode == Enum.KeyCode.N then
		State.NoClip = not State.NoClip
		setNoclipCheck(State.NoClip)
	end
end)

-- Ejecutar la animación de entrada Motion Graphics y abrir el menú al terminar
playMotionGraphicsIntro(function()
	State.MenuOpen = true
	mainContainer.Visible = true
	mainUIScale.Scale = 0.88
	TweenService:Create(mainUIScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = State.UIScale / 100
	}):Play()
end)
