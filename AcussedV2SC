local function playSound(id, vol, pitch)
	pcall(function()
		local s = Instance.new("Sound", SoundService)
		s.SoundId = id
		s.Volume = vol or 0.25
		s.PlaybackSpeed = pitch or 1
		s.PlayOnRemove = true
		s:Destroy()
	end)
end

