local function switchPage(tabName)
	currentActiveTab = tabName
	if searchBox.Text ~= "" then
		searchBox.Text = ""
	end
	for name, p in pairs(pages) do
		if name == tabName then
			p.Visible = true
			p.Position = UDim2.new(0, 8, 0, 14)
			TweenService:Create(p, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 8, 0, 8)
			}):Play()
		else
			p.Visible = false
		end
	end
	for name, bData in pairs(navBtns) do
		local active = (name == tabName)
		TweenService:Create(bData.btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = active and Palette.CardHeader or Palette.Sidebar,
			BackgroundTransparency = active and 0 or 1,
			TextColor3 = active and Palette.Text or Palette.SubText
		}):Play()
		bData.bar.Visible = active
	end
end

