	starBtn.Size = UDim2.new(0, 14, 0, 14)
	starBtn.Position = UDim2.new(1, -14, 0, 3)
	starBtn.BackgroundTransparency = 1
	starBtn.Text = "☆"
	starBtn.Font = Enum.Font.GothamBold
	starBtn.TextSize = 11
	starBtn.TextColor3 = Palette.SubText
	starBtn.ZIndex = 5

	local isFav = false
	local favShortcutBtn = nil

	starBtn.MouseButton1Click:Connect(function()
		playClick()
		isFav = not isFav
		starBtn.Text = isFav and "★" or "☆"
		starBtn.TextColor3 = isFav and State.Accent or Palette.SubText

		if isFav and favGroupLeft then
			favCount += 1
			local targetGrp = (favCount % 2 == 1) and favGroupLeft or favGroupRight
			favShortcutBtn = Instance.new("TextButton", targetGrp.frame)
			favShortcutBtn.Size = UDim2.new(1, 0, 0, 22)
			favShortcutBtn.BackgroundColor3 = Palette.CardHeader
			favShortcutBtn.Text = "  ★ " .. labelText
			favShortcutBtn.Font = Enum.Font.GothamMedium
			favShortcutBtn.TextSize = 10
			favShortcutBtn.TextColor3 = Palette.Text
			favShortcutBtn.TextXAlignment = Enum.TextXAlignment.Left
			favShortcutBtn.TextTruncate = Enum.TextTruncate.AtEnd
			favShortcutBtn.LayoutOrder = favCount + 2
			Instance.new("UICorner", favShortcutBtn).CornerRadius = UDim.new(0, 4)
			Instance.new("UIStroke", favShortcutBtn).Color = Palette.Border

			favShortcutBtn.MouseButton1Click:Connect(function()
				playClick()
				if toggleTriggerFn then toggleTriggerFn() end
			end)
		elseif not isFav and favShortcutBtn then
			favShortcutBtn:Destroy()
			favShortcutBtn = nil
		end
	end)
end

local function addCheckbox(group, labelText, defaultState, defaultColor, callback, colorCallback)
	group.order += 1
	local state = defaultState

	local row = Instance.new("TextButton", group.frame)
	row.Size = UDim2.new(1, 0, 0, 20)
	row.BackgroundTransparency = 1
	row.Text = ""
	row.AutoButtonColor = false
	row.LayoutOrder = group.order
	table.insert(group.items, {inst = row, text = string.lower(labelText)})

	local box = Instance.new("Frame", row)
	box.Size = UDim2.new(0, 13, 0, 13)
	box.Position = UDim2.new(0, 0, 0.5, -6)
	box.BackgroundColor3 = state and State.Accent or Palette.SwitchOff
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)
	local boxStroke = Instance.new("UIStroke", box)
	boxStroke.Color = state and State.Accent or Palette.Border
	boxStroke.Thickness = 1

	local innerDot = Instance.new("Frame", box)
	innerDot.Size = state and UDim2.new(0, 7, 0, 7) or UDim2.new(0, 0, 0, 0)
	innerDot.AnchorPoint = Vector2.new(0.5, 0.5)
	innerDot.Position = UDim2.new(0.5, 0, 0.5, 0)
	innerDot.BackgroundColor3 = Palette.Bg
	Instance.new("UICorner", innerDot).CornerRadius = UDim.new(0, 2)

	local rightPad = defaultColor and -42 or -20
	local lbl = Instance.new("TextLabel", row)
	lbl.Size = UDim2.new(1, rightPad - 20, 1, 0)
	lbl.Position = UDim2.new(0, 20, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 10
	lbl.TextColor3 = state and Palette.Text or Palette.SubText
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Text = labelText
	regFont(lbl, false)

	if defaultColor then
		local swatch = Instance.new("TextButton", row)
		swatch.Size = UDim2.new(0, 16, 0, 11)
		swatch.Position = UDim2.new(1, -34, 0.5, -5)
		swatch.BackgroundColor3 = defaultColor
		swatch.Text = ""
		Instance.new("UICorner", swatch).CornerRadius = UDim.new(0, 3)
		Instance.new("UIStroke", swatch).Color = Palette.Border

		swatch.MouseButton1Click:Connect(function()
			playClick()
			colorModal.Visible = true
			activeColorCallback = function(newCol)
				swatch.BackgroundColor3 = newCol
				if colorCallback then colorCallback(newCol) end
			end
		end)
	end

	local function setVisual(newState)
		state = newState
		TweenService:Create(box, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = state and State.Accent or Palette.SwitchOff
		}):Play()
		TweenService:Create(innerDot, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = state and UDim2.new(0, 7, 0, 7) or UDim2.new(0, 0, 0, 0)
		}):Play()
		boxStroke.Color = state and State.Accent or Palette.Border
		TweenService:Create(lbl, TweenInfo.new(0.18), {
			TextColor3 = state and Palette.Text or Palette.SubText
		}):Play()
	end

	local function triggerToggle()
		setVisual(not state)
		pcall(function() callback(state) end)
	end

	row.MouseButton1Click:Connect(function()
		playClick()
		triggerToggle()
	end)

	attachFavoriteStar(row, labelText, triggerToggle)
	return setVisual
end

local function addSlider(group, labelText, min, max, defaultVal, suffix, callback)
	group.order += 1
	local container = Instance.new("Frame", group.frame)
	container.Size = UDim2.new(1, 0, 0, 28)
	container.BackgroundTransparency = 1
	container.LayoutOrder = group.order
	table.insert(group.items, {inst = container, text = string.lower(labelText)})

	local lbl = Instance.new("TextLabel", container)
	lbl.Size = UDim2.new(0.62, 0, 0, 13)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 10
	lbl.TextColor3 = Palette.SubText
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Text = labelText
	regFont(lbl, false)

	local valLbl = Instance.new("TextLabel", container)
	valLbl.Size = UDim2.new(0.38, 0, 0, 13)
	valLbl.Position = UDim2.new(0.62, 0, 0, 0)
	valLbl.BackgroundTransparency = 1
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 10
	valLbl.TextColor3 = Palette.Text
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.TextTruncate = Enum.TextTruncate.AtEnd
	valLbl.Text = tostring(defaultVal) .. (suffix or "")
	regFont(valLbl, true)

	local track = Instance.new("TextButton", container)
	track.Size = UDim2.new(1, 0, 0, 4)
	track.Position = UDim2.new(0, 0, 0, 19)
	track.BackgroundColor3 = Palette.SwitchOff
	track.Text = ""
	track.AutoButtonColor = false
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local r = math.clamp((defaultVal - min) / (max - min), 0, 1)
	local fill = Instance.new("Frame", track)
	fill.Size = UDim2.new(r, 0, 1, 0)
	fill.BackgroundColor3 = State.Accent
	fill.BorderSizePixel = 0
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	table.insert(ThemeTargets.Accents, {inst = fill, prop = "BackgroundColor3"})

	local knob = Instance.new("Frame", track)
	knob.Size = UDim2.new(0, 8, 0, 8)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(r, 0, 0.5, 0)
	knob.BackgroundColor3 = Palette.Text
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local dragging = false
	local function updateFromInput(input)
		local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local raw = min + (max - min) * ratio
		local val = (max - min <= 10) and (math.round(raw * 100) / 100) or math.round(raw)
		TweenService:Create(fill, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {Size = UDim2.new(ratio, 0, 1, 0)}):Play()
		TweenService:Create(knob, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {Position = UDim2.new(ratio, 0, 0.5, 0)}):Play()
		valLbl.Text = tostring(val) .. (suffix or "")
		pcall(function() callback(val) end)
	end

	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(i)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(i)
		end
	end)
end

