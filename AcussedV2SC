		end)
		pcall(callback)
	end)
end

-- BUSCADOR GLOBAL EN VIVO (Muestra resultados de TODAS las pestañas simultáneamente)
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local q = string.lower(searchBox.Text):gsub("^%s*(.-)%s*$", "%1")
	if q == "" then
		globalSearchPage.Visible = false
		for _, g in ipairs(allGroupboxes) do
			g.frame.Parent = g.homeParent
			g.frame.Visible = true
			for _, it in ipairs(g.items) do
				it.inst.Visible = true
			end
		end
		for name, p in pairs(pages) do
			p.Visible = (name == currentActiveTab)
		end
	else
		for _, p in pairs(pages) do p.Visible = false end
		globalSearchPage.Visible = true
		local matchColIdx = 1
		for _, g in ipairs(allGroupboxes) do
			local groupMatches = string.find(g.title, q, 1, true) ~= nil
			local anyItemMatches = false
			for _, it in ipairs(g.items) do
				local m = groupMatches or (string.find(it.text, q, 1, true) ~= nil)
				it.inst.Visible = m
				if m then anyItemMatches = true end
			end
			if anyItemMatches then
				g.frame.Visible = true
				g.frame.Parent = gsCols[matchColIdx]
				matchColIdx = (matchColIdx == 1) and 2 or 1
			else
				g.frame.Visible = false
			end
		end
	end
end)

